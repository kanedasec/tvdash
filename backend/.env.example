# Token do bot, gerado pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=

# ID do grupo privado autorizado a usar o bot (descubra com get_chat_id.py)
ALLOWED_CHAT_ID=

# Nomes dos dois usuários fixos, separados por vírgula (sem acento é mais seguro pro Telegram, mas acentos funcionam)
USER_NAMES=Pessoa1,Pessoa2

# Fuso horário usado para calcular "semana" e "mês" nos rankings
TIMEZONE=America/Sao_Paulo

# Caminho do arquivo SQLite (relativo à pasta backend/)
DB_PATH=tvdash.db

# Porta do servidor web (backend + API consumida pela Roku e pelo navegador)
PORT=8000

# Horário local (0-23) em que o lembrete de compromissos do dia seguinte é enviado no grupo
REMINDER_HOUR=20

# Protege o dashboard e a API quando o serviço fica acessível pela internet.
# O Compose do VPS força true. Para desenvolvimento estritamente local, pode ficar false.
AUTH_ENABLED=false

# Login HTTP Basic do dashboard web (use uma senha longa e exclusiva).
WEB_USERNAME=
WEB_PASSWORD=

# Chave separada enviada pelo app Roku. Gere com: openssl rand -hex 32
ROKU_API_KEY=
